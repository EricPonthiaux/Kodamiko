<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged by the linker with the one it generates. DPI awareness stays
     Qt's, set at run time (per-monitor v2). No UTF-8 activeCodePage: Kodamiko
     decodes its child processes' output with the ANSI code page
     (QString::fromLocal8Bit), which they keep. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Paths beyond 260 characters (node_modules, deep build trees),
           with the system's LongPathsEnabled. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
