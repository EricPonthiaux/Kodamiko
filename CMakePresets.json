{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/opt/homebrew",
        "CMAKE_BUILD_TYPE": "Release",
        "KDK_LTO": "ON",
        "KDK_NATIVE": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "displayName": "Debug (Ninja)",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KDK_LTO": "OFF",
        "KDK_NATIVE": "OFF"
      }
    },
    {
      "name": "profile",
      "inherits": "default",
      "displayName": "Profiling: optimized with symbols (Ninja)",
      "binaryDir": "${sourceDir}/build-profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "KDK_LTO": "OFF",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -fno-omit-frame-pointer -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -fno-omit-frame-pointer -DNDEBUG",
        "KDK_NATIVE": "OFF"
      }
    },
    {
      "name": "windows",
      "displayName": "Release (Ninja, MSVC)",
      "description": "From an x64 Native Tools prompt, with CMAKE_PREFIX_PATH pointing to Qt (msvc2022_64).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-win",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "KDK_LTO": "ON",
        "KDK_NATIVE": "OFF"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-debug",
      "inherits": "windows",
      "displayName": "Debug (Ninja, MSVC)",
      "binaryDir": "${sourceDir}/build-win-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KDK_LTO": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "profile",
      "configurePreset": "profile"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "profile",
      "configurePreset": "profile",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
