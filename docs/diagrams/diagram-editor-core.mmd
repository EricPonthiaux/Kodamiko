classDiagram
  class Board {
    +meta
    +select / copy / paste
    +addShape(type, props) Shape
    +addLink(type, from, to) Link
    +snapshot() / applySnapshot()
    +undo() / redo()
    +toJson() / fromJson()
  }
  class Inspector {
    +setCodec(codec)
    -applySource()
  }
  class Camera {
    +x, y, scale
    +toScreen(world)
    +toWorld(screen)
  }
  class Style {
    +palette
    +tones
    +fromTheme(theme)$
    +printed()$
  }
  class Shape {
    <<abstract>>
    +id, type, key
    +x, y, w, h
    +draw(painter, board, state)
    +measure(board)
    +ports(board)
    +properties()
  }
  class Link {
    <<abstract>>
    +id, type, from, to
    +label
    +route(board) Route
    +draw(painter, board, selected)
    +properties()
  }
  class Spline {
    +points
    +start, end
  }
  class ShapeType {
    +name
    +make() Shape
  }
  class LinkType {
    +name
    +make() Link
  }
  class ElementPreset {
    +id, label, shapeType
  }
  class RelationPreset {
    +id, label
  }
  class Codec {
    <<abstract>>
    +id() / language() / title()
    +family() Family
    +matches(source) bool
    +parse(source, model) bool
    +serialize(board, meta) QString
    +blank() QString
  }
  class Model {
    +nodes
    +links
    +meta
    +warnings
  }
  class Document {
    <<namespace>>
    +load(board, path, content, loaded)
    +save(board, codec)
    +applySource(board, codec, source)
    +problems(path, content)
  }
  class Loaded {
    +codec
    +needsArrange
    +unplaced
    +warnings
  }
  class Graphviz {
    <<namespace>>
    +autoArrange(board, options)
    +placeNewcomers(board, ids, options)
    +routeLinks(board)
  }
  class ArrangeOptions {
    +rankdir, engine
    +clusters, splines
  }
  class Canvas {
    +fitView(animate)
    +zoomBy(factor)
    +arrange(animate) bool
    +settle(loaded, animate)
    +paintBoard(painter, board)$
  }
  class DiagramView {
    +load(path) bool
    +save() bool
    +reloadFromDisk() bool
    +isModified() bool
    +exportSvg()
    +exportPng()
  }
  class Family {
    +id, title
    +defaultShape, defaultLink
    +autoArrange(board)
    +drawUnderlay(painter, board)
  }
  Board --* DiagramView
  Canvas --* DiagramView
  Inspector --* DiagramView
  DiagramView --> Codec : current format
  Canvas --> Board : shows and edits
  Camera --* Canvas
  Inspector --> Board
  Inspector --> Canvas
  Inspector --> Codec : source text
  Shape "*" --* Board
  Link "*" --* Board
  Style --* Board
  Board --> Family
  Spline "0..1" --* Link
  Link ..> Shape : from / to
  ShapeType "*" --* Family
  LinkType "*" --* Family
  ElementPreset "*" --* Family
  RelationPreset "*" --* Family
  ShapeType ..> Shape : makes
  LinkType ..> Link : makes
  Codec --> Family
  Codec ..> Model : parses into
  Codec ..> Board : serializes
  Document ..> Codec : picks
  Document ..> Loaded : fills
  Document ..> Board : builds
  Canvas ..> Graphviz : arranges with
  Graphviz ..> ArrangeOptions
  Graphviz ..> Board : places shapes, routes links

