classDiagram
  class EntryPopup
  class DiagramRequestPopup {
    +Apply(kindId, name, description)
    #accept()
  }
  class DiagramKind {
    +id, title
    +extension
    +blank
  }
  class DiagramKinds {
    <<namespace>>
    +available()
    +find(id)
    +withExtension(name, kind)
  }
  class DiagramRequest {
    <<namespace>>
    +prompt(kindTitle, path, description)
    +arguments(prompt, path, plugin, hook)
    +parseLine(line, workDir) Event
  }
  class Event {
    +kind : None, Steps, Finished
    +steps
    +failed
    +text
  }
  class DiagramCheck {
    <<namespace>>
    +problems(path, content)
    +feedbackOutput(file, problems)
  }
  class Document {
    <<namespace>>
    +problems(path, content)
  }
  class MainWindow
  class DiagramGenerationView {
    +start()
    +finished(path, summary)
    +closeRequested()
    -readOutput()
    -onHookReceived(event)
  }
  class DiagramView
  class HookServer
  DiagramRequestPopup --|> EntryPopup
  MainWindow ..> DiagramRequestPopup : opens
  DiagramRequestPopup --> "*" DiagramKind : offers
  DiagramKinds ..> DiagramKind : lists
  MainWindow ..> DiagramGenerationView : opens in a tab
  DiagramGenerationView ..> DiagramRequest : builds prompt, reads output
  DiagramRequest ..> Event : parses into
  HookServer --* DiagramGenerationView
  MainWindow ..> DiagramCheck : answers Claude's hooks
  DiagramCheck ..> Document : reads like the editor
  MainWindow ..> DiagramView : opens the result

