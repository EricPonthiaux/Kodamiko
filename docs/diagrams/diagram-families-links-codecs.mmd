  class Link {
    <<abstract>>
    +route(board) Route
    +draw(painter, board, selected)
    +properties()
  }
  class Codec {
    <<abstract>>
    +matches(source) bool
    +parse(source, model) bool
    +serialize(board, meta) QString
  }
  FlowLink --|> Link : flowchart
  MessageLink --|> Link : sequence
