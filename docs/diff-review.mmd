flowchart TB
  nothing["Message: stage first"]
  step{"Review step enabled?"}
  modeReview["Review mode: review page"]
  modeDiff["Stays in Diff mode: progress bar"]
  hasCheck{"Does the project have a check?"}
  check["Run the project's check"]
  passed{"Check passed?"}
  failed["Check failed"]
  anyway["Review Anyway"]
  reviewer["Separate read-only reviewer agent reads the patch"]
  error["Review failed"]
  dismiss["Dismiss"]
  send["Send to the session's prompt"]
  commit["Commit"]
  empty{"Nothing staged?"}
  diff["Diff mode: changed files and diff"]
  ask["Review or Review Again button"]
  stage["Stage files, hunks or lines"]
  save["Message: save first"]
  read["Read the staged changes as one patch"]
  unsaved{"Unsaved files?"}
  fix["Have the session fix it"]
  act{"What to do with a finding?"}
  grid["Grid of findings over the diff"]
  findings["Findings: notes in the diff, Problems panel"]
  answer{"Valid answer?"}
  diff --> stage
  stage --> ask
  ask --> unsaved
  unsaved -->|yes| save
  unsaved -->|no| read
  read --> empty
  empty -->|yes| nothing
  empty -->|no| step
  step -->|yes| modeReview
  modeReview --> hasCheck
  step -->|no| modeDiff
  modeDiff --> hasCheck
  hasCheck -->|no| reviewer
  hasCheck -->|yes| check
  check --> passed
  passed -->|yes| reviewer
  passed -->|no| failed
  failed --> anyway
  anyway --> reviewer
  reviewer --> answer
  answer -->|no| error
  answer -->|Yes| findings
  findings -->|without Review step| grid
  findings --> act
  grid --> act
  act --> dismiss
  act --> send
  act --> fix
  fix --> stage
  dismiss --> commit

