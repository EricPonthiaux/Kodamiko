classDiagram
  class AgentProvider {
    <<interface>>
    name()
    mark()
    features()
    sessionProcess(folder, hookServer, options)
    fileRunProcess(run)
    reviewRunProcess(run)
    parseHook(json) HookEvent
  }
  class ClaudeCodeProvider
  class AgentProviders {
    <<namespace>>
    all()
    find(key)
    key(provider)
  }
  class Agent {
    worktree
    sessionId
    terminal
    lastPrompt
    pendingReport
  }
  class AgentActivity {
    state
    handle(event)
    interrupt()
    setWatched(watched)
  }
  class Worktree {
    name
    path
    branch
    baseCommit
  }
  class Worktrees {
    <<namespace>>
    add(repository, name)
    hasWork(worktree)
    rebase(worktree, onto)
    fastForward(repository, branch)
    remove(repository, worktree)
  }
  class AgentRun {
    start(spec, timeout)
    stop()
    stepsAdded(steps)
    finished(outcome)
  }
  class TerminalWidget
  class NewAgentPopup {
    popup(suggestedName, changes)
    startRequested(name)
  }
  class CloseAgentPopup {
    popup(worktree)
    fateChosen(worktree, fate)
  }
  class HookEvent {
    kind
    sessionId
    workingDirectory
    filePaths
    prompt
  }
  class State {
    <<enumeration>>
    Idle
    Working
    NeedsInput
    Done
  }
  class HookServer {
    listen()
    deferReply()
    respond(json)
    hookReceived(event)
  }
  class MainWindow {
    agentProvider_
    hookServer_
    agentSessions_
    agentMerges_
    closeAgentTab(worktree, fate)
    mergeAgentWork(worktree, lastPrompt, afterMerge)
  }
  class AgentSessions {
    add(worktree, sessionId, terminal)
    find(event)
    handle(event)
    sendBack(agent, report, head)
    activityChanged(terminal, state)
    attentionRequested(title, message)
  }
  class AgentMergeQueue {
    enqueue(worktree, afterMerge)
    watch(statuses)
    merged()
    sentBack()
    waiting()
  }
  class ProjectCheck
  class AgentIndicator {
    setStatus(status)
    setProvider(provider)
  }
  ClaudeCodeProvider ..|> AgentProvider
  AgentProviders --> AgentProvider : lists
  MainWindow --> AgentProvider : current agent
  HookServer --* MainWindow
  AgentSessions --* MainWindow
  AgentMergeQueue --* MainWindow
  NewAgentPopup --* MainWindow
  CloseAgentPopup --* MainWindow
  AgentIndicator --* MainWindow
  HookServer --> AgentProvider : decodes with
  HookServer ..> HookEvent : emits
  Agent "*" --* AgentSessions
  AgentActivity --* Agent
  Agent --> Worktree
  Agent --> TerminalWidget : its tab
  AgentActivity --> State
  AgentSessions ..> HookEvent : handles
  AgentMergeQueue ..> Worktrees : replays, fast-forwards
  ProjectCheck --* AgentMergeQueue : runs the check
  AgentMergeQueue ..> AgentSessions : sends work back
  Worktrees ..> Worktree : creates
  AgentRun --> AgentProvider : decodes output
  AgentIndicator --> AgentProvider : shows its mark
  NewAgentPopup ..> Worktree : names
  CloseAgentPopup ..> Worktree : asks its fate

