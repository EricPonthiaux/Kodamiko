# clangd runs clang-tidy on every file opened in the editor, regardless of
# .clang-tidy's HeaderFilterRegex: Duet's rules must not flag the dependencies
# a go-to-definition opens (libgit2, Scintilla, libvterm...).
If:
  PathMatch: (build[^/]*|third_party)/.*
Diagnostics:
  ClangTidy:
    Remove: '*'
