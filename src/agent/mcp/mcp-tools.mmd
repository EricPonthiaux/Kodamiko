mindmap
  root((Kodamiko's MCP tools))
    editor[Editor]
      editorState[State, open files, text]
      editorOpen[Open, save]
      editorDiff[Show a diff]
      editorPrompts[Prompts: review, fixes, explanation]
    tabs[Tabs]
      tabsList[List, show]
      tabsText[Read a tab's text]
    terminals[Terminals]
      termRead[List, read]
      termRun[Run a command]
    workspace[Workspace]
      wsSearch[Search text, files, symbols]
      wsCommands[List, run commands]
      wsInfo[Project info]
      wsNotify[Notify the user]
    code[Code and language]
      codeProblems[Diagnostics]
      codeNav[Definition, references, info]
      codeActions[Code actions, formatting]
    refactoring[Refactoring]
      refRename[Rename a symbol, a file]
      refUsages[Usages]
      refSignature[Change a signature]
    diagrams[Diagrams]
      diagRead[Kinds, read, problems]
      diagEdit[Apply the source, lay out]
      diagSelect[Select, export]
    git[Git: changes]
      gitRead[Status, history, commit]
      gitSnapshots[Snapshots: create, restore]
      gitStage[Show, stage, discard]
      gitCommit[Commit, message]
    branches[Git: branches]
      brManage[Switch, delete, rename]
      brStash[Stash: save, apply, drop]
      brRemote[Fetch, pull, push]
    integration[Git: integration]
      intMerge[Merge or rebase]
      intFlow[Continue, abort, skip]
      intConflicts[Resolve conflicts]
      intPick[Cherry-pick, revert]

