# Static analysis of Duet's code (src/, tests/, tools/). Run it with
# `cmake --build build --target tidy`, or at each compilation by configuring
# with -DDUET_CLANG_TIDY=ON.
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-throwing-static-initialization,
  clang-analyzer-*,
  -clang-analyzer-optin.cplusplus.VirtualCall,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-static-cast-downcast,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-narrowing-conversions,
  misc-*,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-avoid-c-style-cast,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-use-designated-initializers,
  -modernize-raw-string-literal,
  -modernize-use-integer-sign-comparison,
  -modernize-use-ranges,
  performance-*,
  -performance-enum-size,
  readability-*,
  -readability-braces-around-statements,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -readability-named-parameter,
  -readability-redundant-access-specifiers,
  -readability-convert-member-functions-to-static,
  -readability-trailing-comma

# Why some checks are off (a check removed with `-` must come after the
# group that adds it):
# - owning-memory: Qt widgets are created with `new` and owned by their parent.
# - redundant-access-specifiers: `public slots:` / `signals:` sections.
# - braces-around-statements: single-statement `if` without braces is the style.
# - implicit-bool-conversion: `if (pointer)` is idiomatic with Qt.
# - avoid-c-style-cast: it also reports functional casts (`int(x)`), the
#   style for arithmetic conversions; true C-style casts are still reported
#   by cppcoreguidelines-pro-type-cstyle-cast.
# - pro-type-static-cast-downcast: Qt hands events as QEvent, to be cast to
#   the type their type() names; QObjects go down with qobject_cast.
# - throwing-static-initialization (and cert-err58-cpp): a static QString or
#   QRegularExpression throws only when memory runs out.
# - math-missing-parentheses: `a * b + c` reads as it computes.
# - named-parameter: an override does not name what it does not use.
# - raw-string-literal: moc misreads some raw strings and then skips the
#   whole file's classes; lupdate does not extract them either.
# - use-integer-sign-comparison: `row >= int(list.size())` reads better than
#   std::cmp_greater_equal(row, list.size()).
# - use-ranges: std::sort(list.begin(), list.end()) is as clear, and the
#   rewrite breaks comparators that compare two types.
# - enum-size: an enum class's int is no cost worth a uint8_t everywhere.
# - pointer arithmetic, reinterpret_cast, varargs: Scintilla, libgit2 and
#   libvterm are C APIs.

WarningsAsErrors: ''
# Qt's CMake package adds this GCC-only flag, which clang does not know.
RemovedArgs: ['-mno-direct-extern-access']
HeaderFilterRegex: '.*/(src|tests|tools)/.*'
# Dependencies built from their sources also have src/ directories.
ExcludeHeaderFilterRegex: '.*/(_deps|third_party|build[^/]*)/.*'
FormatStyle: file

CheckOptions:
  readability-function-cognitive-complexity.Threshold: 15
  readability-function-cognitive-complexity.IgnoreMacros: true
  readability-function-size.ParameterThreshold: 4
  readability-function-size.NestingThreshold: 4
  bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: true
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true

  # Naming, as in the existing code: PascalCase types, camelCase functions,
  # variables and constants, private members with a `_` suffix.
  readability-identifier-naming.NamespaceCase: aNy_CasE
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberSuffix: '_'
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberSuffix: '_'
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  # Qt Test finds the data of `test()` in `test_data()`; C libraries
  # (tree-sitter grammars, Graphviz plugins) name their symbols themselves.
  readability-identifier-naming.MethodIgnoredRegexp: '^[a-z][A-Za-z0-9]*_data$'
  readability-identifier-naming.FunctionIgnoredRegexp: '^tree_sitter_[a-z_]+$'
  readability-identifier-naming.VariableIgnoredRegexp: '^gvplugin_[a-z_]+_LTX_library$'
...
