{
    "$schema": "https://raw.githubusercontent.com/EricPonthiaux/Kodamiko/main/tools/schemas/recipe.schema.json",
    "title": "Java · Maven",
    "language": "java",
    "description": "pom.xml (the JDK chosen below, downloaded if the machine has none) and src/main/java/Main.java, built with Maven. Debug waits for a debugger on port 5005.",
    "parameters": [
        {
            "name": "java",
            "title": "Java",
            "values": [
                "25",
                "21"
            ]
        }
    ],
    "requires": [
        {
            "tool": "jdk",
            "version": "{{java}}",
            "path": [
                "{{home}}/bin"
            ],
            "variables": {
                "JAVA_HOME": "{{home}}"
            }
        },
        {
            "tool": "maven",
            "version": "3.9.16",
            "program": "mvn",
            "download": {
                "any": {
                    "url": "https://archive.apache.org/dist/maven/maven-3/{{version}}/binaries/apache-maven-{{version}}-bin.zip",
                    "checksumUrl": "{{url}}.sha512",
                    "algorithm": "sha512",
                    "check": "bin/mvn"
                }
            },
            "path": [
                "{{home}}/bin"
            ],
            "variables": {
                "MAVEN_HOME": "{{home}}"
            }
        }
    ],
    "servers": {
        "jdtls": {
            "version": "1.62.0",
            "runtime": {
                "tool": "jdk",
                "version": "25"
            }
        }
    },
    "run": [
        {
            "name": "Build",
            "kind": "build",
            "command": "mvn package"
        },
        {
            "name": "Run",
            "kind": "run",
            "command": "java -cp target/classes Main"
        },
        {
            "name": "Debug",
            "kind": "debug",
            "command": "java -agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5005 -cp target/classes Main"
        }
    ]
}
