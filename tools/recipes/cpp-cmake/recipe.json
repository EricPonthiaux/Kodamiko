{
    "$schema": "https://raw.githubusercontent.com/EricPonthiaux/Kodamiko/main/tools/schemas/recipe.schema.json",
    "title": "C++ · CMake",
    "language": "cpp",
    "description": "CMakeLists.txt (C++20) and src/main.cpp, an executable built with the system's compiler.",
    "systems": [
        "linux",
        "macos"
    ],
    "requires": [
        {
            "tool": "cmake",
            "version": "4.4.4",
            "program": "cmake",
            "download": {
                "linux-x64": {
                    "url": "https://github.com/Kitware/CMake/releases/download/v{{version}}/cmake-{{version}}-linux-x86_64.tar.gz",
                    "checksumUrl": "https://github.com/Kitware/CMake/releases/download/v{{version}}/cmake-{{version}}-SHA-256.txt",
                    "check": "bin/cmake"
                },
                "linux-aarch64": {
                    "url": "https://github.com/Kitware/CMake/releases/download/v{{version}}/cmake-{{version}}-linux-aarch64.tar.gz",
                    "checksumUrl": "https://github.com/Kitware/CMake/releases/download/v{{version}}/cmake-{{version}}-SHA-256.txt",
                    "check": "bin/cmake"
                },
                "macos": {
                    "url": "https://github.com/Kitware/CMake/releases/download/v{{version}}/cmake-{{version}}-macos-universal.tar.gz",
                    "checksumUrl": "https://github.com/Kitware/CMake/releases/download/v{{version}}/cmake-{{version}}-SHA-256.txt",
                    "check": "CMake.app/Contents/bin/cmake"
                }
            },
            "path": [
                "{{home}}/bin",
                "{{home}}/CMake.app/Contents/bin"
            ]
        },
        {
            "tool": "clang-format",
            "version": "23.1.3",
            "program": "clang-format",
            "download": {
                "linux-x64": {
                    "url": "https://files.pythonhosted.org/packages/11/d1/658d3da4dcbca98620956868c7cf6f4ba19fccecbdfc30cc055e19c9d4a7/clang_format-23.1.3-py2.py3-none-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl",
                    "checksum": "58bf1804216501669832a39f2415e14284337438a062ff564729792adec664ac",
                    "format": "zip",
                    "check": "clang_format/data/bin/clang-format"
                },
                "linux-aarch64": {
                    "url": "https://files.pythonhosted.org/packages/1d/00/a0f99e24dc4892fb120e82fa9cf6e8fcb92714181ffd1165ab7eaf5ba1fd/clang_format-23.1.3-py2.py3-none-manylinux_2_26_aarch64.manylinux_2_28_aarch64.whl",
                    "checksum": "072113527b49a9c0ab9058006d9fe20e583823e6482608a34e1883dd2c49ae7d",
                    "format": "zip",
                    "check": "clang_format/data/bin/clang-format"
                },
                "macos-x64": {
                    "url": "https://files.pythonhosted.org/packages/05/0f/a1813ede1e149e700ee810baf22dd9c863ca0bd719d73f86e8c10b67a6bb/clang_format-23.1.3-py2.py3-none-macosx_10_9_x86_64.whl",
                    "checksum": "0b8e86cc5a870ca42989bd1ccfe5220fbab96e386922d0a8f0ca350db30593df",
                    "format": "zip",
                    "check": "clang_format/data/bin/clang-format"
                },
                "macos-aarch64": {
                    "url": "https://files.pythonhosted.org/packages/47/a5/2007b7a7a53dfe417e66d0a6b38b2f87f16391bfe6fe522d436d1e50be1c/clang_format-23.1.3-py2.py3-none-macosx_11_0_arm64.whl",
                    "checksum": "79f53ac55434af6dda88eb90eeb65d903ff920c910f78041de41e3ca666dfba5",
                    "format": "zip",
                    "check": "clang_format/data/bin/clang-format"
                }
            },
            "path": [
                "{{home}}/clang_format/data/bin"
            ]
        },
        {
            "tool": "clang-tidy",
            "version": "23.1.3",
            "program": "clang-tidy",
            "download": {
                "linux-x64": {
                    "url": "https://files.pythonhosted.org/packages/7a/f0/5d684465b0727e3d5364de38cead2775f73ff35f63694176a0694c2ab943/clang_tidy-23.1.3-py2.py3-none-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl",
                    "checksum": "6b2558bc396a6e792190700134609e041f657d7f8d15385e8b0aa66f5ffe21b5",
                    "format": "zip",
                    "check": "clang_tidy/data/bin/clang-tidy"
                },
                "linux-aarch64": {
                    "url": "https://files.pythonhosted.org/packages/3d/6f/1c50dacbc9ae537e0e40be27fa7b0a56e60dcc0a1fffd0d9b280b1ed6749/clang_tidy-23.1.3-py2.py3-none-manylinux_2_26_aarch64.manylinux_2_28_aarch64.whl",
                    "checksum": "5639a8e65df6701ac144ee6b9e73aef4bdd3706cdc5849de1a5147c5aeaddf24",
                    "format": "zip",
                    "check": "clang_tidy/data/bin/clang-tidy"
                },
                "macos-x64": {
                    "url": "https://files.pythonhosted.org/packages/f0/a6/b5b34b1770cc50aa216d33a45456c1a69375dee40a0abad91ef2656d570c/clang_tidy-23.1.3-py2.py3-none-macosx_10_9_x86_64.whl",
                    "checksum": "6d745b16e375bfc2219bca5f6697dc17348313f6b1fc58f8fa7321172a59ecdf",
                    "format": "zip",
                    "check": "clang_tidy/data/bin/clang-tidy"
                },
                "macos-aarch64": {
                    "url": "https://files.pythonhosted.org/packages/26/42/65a2c5ee9be88b81d3890df15fd1af7f5bbab72a16ccf4d302454385e067/clang_tidy-23.1.3-py2.py3-none-macosx_11_0_arm64.whl",
                    "checksum": "cbd31dea271cee7ed5b5048847e73b8208c8dde90e321e09c20d9146011f8ff2",
                    "format": "zip",
                    "check": "clang_tidy/data/bin/clang-tidy"
                }
            },
            "path": [
                "{{home}}/clang_tidy/data/bin"
            ]
        }
    ],
    "run": [
        {
            "name": "Configure default",
            "kind": "build",
            "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release",
            "systems": [
                "linux",
                "macos"
            ]
        },
        {
            "name": "Configure debug",
            "kind": "build",
            "command": "cmake -S . -B build-debug -DCMAKE_BUILD_TYPE=Debug",
            "systems": [
                "linux",
                "macos"
            ]
        },
        {
            "name": "Build default",
            "kind": "build",
            "command": "cmake --build build",
            "systems": [
                "linux",
                "macos"
            ]
        },
        {
            "name": "Build debug",
            "kind": "build",
            "command": "cmake --build build-debug",
            "systems": [
                "linux",
                "macos"
            ]
        },
        {
            "name": "Run default",
            "kind": "run",
            "command": "build/{{identifier}}",
            "systems": [
                "linux",
                "macos"
            ]
        },
        {
            "name": "Run debug",
            "kind": "run",
            "command": "build-debug/{{identifier}}",
            "systems": [
                "linux",
                "macos"
            ]
        },
        {
            "name": "Debug",
            "kind": "debug",
            "command": "gdb build-debug/{{identifier}}",
            "systems": [
                "linux",
                "macos"
            ]
        }
    ],
    "setup": [
        "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release",
        "cmake -S . -B build-debug -DCMAKE_BUILD_TYPE=Debug"
    ]
}
