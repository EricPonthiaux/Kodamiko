{
    "$schema": "https://raw.githubusercontent.com/EricPonthiaux/Duet/main/tools/schemas/recipe.schema.json",
    "title": "Qt Widgets · CMake · MSVC",
    "language": "cpp",
    "description": "A Qt 6 Widgets window, built with Visual Studio's compiler and Qt 6.10 (msvc2022_64), downloaded if the machine has none.",
    "systems": [
        "windows"
    ],
    "environment": {
        "visualStudio": true
    },
    "requires": [
        {
            "tool": "clang-format",
            "version": "23.1.3",
            "program": "clang-format",
            "download": {
                "windows-x64": {
                    "url": "https://files.pythonhosted.org/packages/23/a6/90148f91544e3c056e78c514f0e764c1b44d50a33344c83fd03011ea97c8/clang_format-23.1.3-py2.py3-none-win_amd64.whl",
                    "checksum": "6c2b74c3a3e942ec172d768e7b945f8e136db05a7b735d49ecfc69bda97643ad",
                    "format": "zip",
                    "check": "clang_format/data/bin/clang-format.exe"
                },
                "windows-aarch64": {
                    "url": "https://files.pythonhosted.org/packages/fb/ed/47bda876e360ca71f366f256939dd674e7a5f4f8deae6eddf7819ea21832/clang_format-23.1.3-py2.py3-none-win_arm64.whl",
                    "checksum": "583af22e6593b8ea463412cf3411f55731f117546ad13e88b9ce585e7c47475f",
                    "format": "zip",
                    "check": "clang_format/data/bin/clang-format.exe"
                }
            },
            "path": [
                "{{home}}/clang_format/data/bin"
            ]
        },
        {
            "tool": "clang-tidy",
            "version": "23.1.3",
            "program": "clang-tidy",
            "download": {
                "windows-x64": {
                    "url": "https://files.pythonhosted.org/packages/ac/f0/cd5021e635cebaf42c696c46ecc583d77b4e3a396a1a58cdadb8b99c4ef2/clang_tidy-23.1.3-py2.py3-none-win_amd64.whl",
                    "checksum": "cf0d0e671f707b5a668c035382b964056067076445e87b736b19ff482229010a",
                    "format": "zip",
                    "check": "clang_tidy/data/bin/clang-tidy.exe"
                }
            },
            "path": [
                "{{home}}/clang_tidy/data/bin"
            ]
        },
        {
            "tool": "qt",
            "version": "6.10",
            "kit": "msvc2022_64",
            "path": [
                "{{home}}/bin"
            ],
            "variables": {
                "CMAKE_PREFIX_PATH": "{{home}}"
            }
        }
    ],
    "run": [
        {
            "name": "Configure default",
            "kind": "build",
            "command": "cmake -S . -B build -G Ninja -DCMAKE_CXX_COMPILER=cl -DCMAKE_BUILD_TYPE=Release",
            "systems": [
                "windows"
            ]
        },
        {
            "name": "Configure debug",
            "kind": "build",
            "command": "cmake -S . -B build-debug -G Ninja -DCMAKE_CXX_COMPILER=cl -DCMAKE_BUILD_TYPE=Debug",
            "systems": [
                "windows"
            ]
        },
        {
            "name": "Build default",
            "kind": "build",
            "command": "cmake --build build",
            "systems": [
                "windows"
            ]
        },
        {
            "name": "Build debug",
            "kind": "build",
            "command": "cmake --build build-debug",
            "systems": [
                "windows"
            ]
        },
        {
            "name": "Run default",
            "kind": "run",
            "command": "build\\{{identifier}}.exe",
            "systems": [
                "windows"
            ]
        },
        {
            "name": "Run debug",
            "kind": "run",
            "command": "build-debug\\{{identifier}}.exe",
            "systems": [
                "windows"
            ]
        },
        {
            "name": "Debug",
            "kind": "debug",
            "command": "devenv /DebugExe build-debug\\{{identifier}}.exe",
            "systems": [
                "windows"
            ]
        }
    ],
    "setup": [
        "cmake -S . -B build -G Ninja -DCMAKE_CXX_COMPILER=cl -DCMAKE_BUILD_TYPE=Release",
        "cmake -S . -B build-debug -G Ninja -DCMAKE_CXX_COMPILER=cl -DCMAKE_BUILD_TYPE=Debug"
    ],
    "prompts": [
        {
            "title": "Add a Dialog",
            "text": "Add a dialog to this Qt application: "
        },
        {
            "title": "Add a Menu Action",
            "text": "Add a menu action to the main window that "
        },
        {
            "title": "Add a Settings Page with QSettings",
            "text": "Add a settings dialog, saved with QSettings, with these settings: "
        }
    ]
}
